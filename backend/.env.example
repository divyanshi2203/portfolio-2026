# Local dev — SQLite is fine. On Railway, set DATABASE_URL to the
# Postgres connection string from the Postgres plugin.
DATABASE_URL=sqlite:///./portfolio.db

# Primary frontend origin (your Vercel domain or custom domain).
FRONTEND_URL=http://localhost:5173

# Optional: comma-separated list of extra allowed origins.
# Example: ALLOWED_ORIGINS=https://divyanshi.com,https://www.divyanshi.com
ALLOWED_ORIGINS=
